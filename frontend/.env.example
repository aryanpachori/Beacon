# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Google OAuth (Sign in with Google) — same Client ID as backend GOOGLE_CLIENT_ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Gemini AI — server-side only (do NOT prefix NEXT_PUBLIC_)
# Free models: gemini-1.5-flash, gemini-1.5-flash-8b
GEMINI_API_KEY=
