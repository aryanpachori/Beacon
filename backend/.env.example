# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Public API URL for GitHub OAuth redirect (use localhost:4000 in dev)
API_PUBLIC_URL=http://localhost:4000

# Database (PostgreSQL / Supabase)
# App runtime — transaction pooler (port 6543, pgbouncer)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrations & db push — session pooler (port 5432)
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
# Local Docker Compose (both URLs can be the same):
# DATABASE_URL=postgresql://beacon:beacon@localhost:5432/beacon
# DIRECT_URL=postgresql://beacon:beacon@localhost:5432/beacon

# Redis — BullMQ queues, signal cache, rate limits (hosted Upstash or local)
# Upstash (TLS): rediss://default:YOUR_TOKEN@YOUR-ENDPOINT.upstash.io:6379
# Local: redis://localhost:6379
REDIS_URL=rediss://default:YOUR_TOKEN@YOUR-ENDPOINT.upstash.io:6379

# Google OAuth (Sign in with Google — verifies ID token from Google Identity Services)
# Create at https://console.cloud.google.com/apis/credentials — Web application client,
# no client secret needed since we only verify the ID token server-side.
GOOGLE_CLIENT_ID=

# JWT
JWT_SECRET=your-super-secret-jwt-key
JWT_REFRESH_SECRET=your-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# GitHub App (required for Connect GitHub / scan flow)
# Create at https://github.com/settings/apps — see backend README or docs below.
#
# REQUIRED for install + scan:
#   GITHUB_APP_ID          — numeric App ID from GitHub App settings
#   GITHUB_APP_PRIVATE_KEY_PATH — path to downloaded .pem (recommended locally)
#   GITHUB_APP_PRIVATE_KEY — alternative: PEM contents (use \n for newlines in .env)
#   GITHUB_APP_NAME        — URL slug, e.g. beacon → github.com/apps/beacon
#
# REQUIRED for push webhooks (repo rescan on manifest change):
#   GITHUB_APP_WEBHOOK_SECRET — same secret configured on the GitHub App
#   Callback URL: https://YOUR_API_HOST/api/webhooks/github
#
# OPTIONAL (legacy OAuth — not used by current install flow):
#   GITHUB_CLIENT_ID
#   GITHUB_CLIENT_SECRET
#
# GitHub App permissions needed: Metadata (read), Contents (read), Issues (read),
# Pull requests (read). Subscribe to: installation, installation_repositories, push.
# Setup URL / Callback URL for OAuth: not required for App install flow.
# After install, GitHub redirects to: {API_URL}/api/github/callback?installation_id=…&state={userId}
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_NAME=beacon

# Email — Gmail SMTP (app password, not your account password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_USER=kapoorsamarth7@gmail.com
SMTP_PASS=vnvn jmax qwxn fpmh

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Standard Checkout (Pro ₹999/mo):
#   POST /api/billing/create-order   — auth required
#   POST /api/billing/verify-payment — HMAC signature verify, upgrades user to pro

# Intelligence / SPS scoring (py-intelligence/ runs as a separate process)
# API must expose INTERNAL_WEBHOOK_SECRET for py-intelligence score-complete callbacks.
# Do not set ENABLE_NODE_INTELLIGENCE_WORKER=true while py-intelligence is running.
INTERNAL_WEBHOOK_SECRET=change-me
# ENABLE_NODE_INTELLIGENCE_WORKER=false

# Slack Webhooks
FEEDBACK_SLACK_WEBHOOK=   # user feedback from the feedback modal
ALERT_SLACK_WEBHOOK=      # backend 5xx error alerts (separate channel)
