# py-intelligence worker — copy to .env (also reads backend/.env for shared secrets)

REDIS_URL=rediss://default:YOUR_TOKEN@YOUR-ENDPOINT.upstash.io:6379
API_PUBLIC_URL=http://localhost:4000
INTERNAL_WEBHOOK_SECRET=change-me

# XGBoost model (relative to repo root)
MODEL_PATH=data/beacon_model.json

# Local only — backend/.env sets PORT=4000 for the API; override so health server does not collide
PORT=8081
